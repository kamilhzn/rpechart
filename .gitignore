# ---- Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.venv/
venv/
dist/

# ---- 运行产物（写完的谱面 / 视频 / 音频不进版本库）
build/
work/
*.mp4
*.wav
*.flac
*.ogg

# ---- 编辑器/系统
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# ---- 但测试样本必须进版本库：
# tests/fixtures/ 里的谱面、.pez 与合成媒体由 make_fixtures.py 生成，
# 不含任何第三方素材，是保真回测的唯一依据。
!tests/fixtures/**
!tests/fixtures/charts/*.json
!tests/fixtures/*.pez
!tests/fixtures/media/*.mp3
!tests/fixtures/media/*.mp4
